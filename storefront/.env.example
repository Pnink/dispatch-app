# Copy to .env.local and fill in. Never commit .env.local.

# Required once the app is reachable from anywhere other than this computer.
# Use a long passphrase (4+ random words). Changing it signs you out everywhere.
OWNER_PASSWORD=

# Optional: a separate random secret for signing sessions (otherwise derived from OWNER_PASSWORD).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where your data is saved (default: ./data next to the app).
DATA_DIR=

# AI models (optional). Leave empty to use the free built-in rules.
# Claude models: create a key at console.anthropic.com (billed per use, separate from Claude.ai plans).
ANTHROPIC_API_KEY=
# ChatGPT models: create a key at platform.openai.com (billed per use, separate from ChatGPT plans).
OPENAI_API_KEY=

# Payments with Stripe (optional; without it checkout runs in demo mode and nothing is charged).
# Test first: Stripe dashboard -> Test mode -> Developers -> API keys -> Secret key (sk_test_...).
STRIPE_SECRET_KEY=
# From Developers -> Webhooks -> your endpoint (https://yourshop.com/api/stripe/webhook) -> Signing secret.
STRIPE_WEBHOOK_SECRET=
# Your shop's public address, where Stripe sends shoppers back after paying.
PUBLIC_URL=

# Customer emails: receipts + tracking (optional). resend.com, free tier. MAIL_FROM must use a domain you verified there.
RESEND_API_KEY=
MAIL_FROM=
