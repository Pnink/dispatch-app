{
  "_about": "Design tokens for Quotidian. Roles measured from the original's dark presentation (near-black canvas, light serif text, glassy round controls). Values are our own; replica-brand may swap them. Check with: python3 contrast.py tokens.json",
  "color": {
    "bg": "#0c0c0e",
    "surface": "#18181b",
    "surface-2": "#232327",
    "border": "#2e2e33",
    "border-input": "#77777f",
    "text": "#f4f2ee",
    "text-muted": "#a6a4ab",
    "accent": "#efe8dc",
    "on-accent": "#141414",
    "danger": "#ff7a7a",
    "success": "#5ccf95",
    "like": "#ff6b81",
    "glass": "#ffffff1f",
    "on-glass": "#ffffff"
  },
  "pairs": [
    ["text", "bg"],
    ["text", "surface"],
    ["text", "surface-2"],
    ["text-muted", "bg"],
    ["text-muted", "surface"],
    ["text-muted", "surface-2"],
    ["on-accent", "accent"],
    ["accent", "bg"],
    ["danger", "bg"],
    ["danger", "surface"],
    ["success", "bg"],
    ["like", "bg"],
    ["border-input", "bg", "ui"],
    ["border-input", "surface", "ui"]
  ],
  "font": {
    "sans": "Inter",
    "serif": "Lora",
    "display": "Playfair Display",
    "hand": "Caveat",
    "mono": "DM Mono"
  },
  "type": {
    "xs": {"size": 12, "line": 16, "weight": 500},
    "sm": {"size": 14, "line": 20, "weight": 400},
    "base": {"size": 16, "line": 24, "weight": 400},
    "lg": {"size": 20, "line": 28, "weight": 600},
    "xl": {"size": 28, "line": 34, "weight": 700},
    "quote": {"size": 30, "line": 40, "weight": 500}
  },
  "space": [0, 4, 8, 12, 16, 24, 32, 48, 64],
  "radius": {"sm": 8, "md": 14, "lg": 22, "pill": 999},
  "shadow": {
    "pop": "0 12px 32px rgba(0,0,0,.45)"
  },
  "motion": {"fast": "120ms", "base": "220ms", "ease": "cubic-bezier(.2,.8,.2,1)"}
}
